---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title"><span class="lang-en">{{ page.title }}</span><span class="lang-ko">{{ page.title_ko | default: page.title }}</span></h1>
    <p class="post-description"><span class="lang-en">{{ page.description }}</span><span class="lang-ko">{{ page.description_ko | default: page.description }}</span></p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.plugins contains 'al_comments' %}
    {% include plugins/al_comments.liquid %}
  {% endif %}
</div>
