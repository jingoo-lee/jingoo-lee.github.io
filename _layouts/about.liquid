---
layout: default
---
<div class="post about-page">
  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section">
        <div class="section-eyebrow"><span class="lang-en">Latest</span><span class="lang-ko">최근 소식</span></div>
        <h2 class="section-title">
          <a href="{{ '/news/' | relative_url }}" style="color: inherit"><span class="lang-en">News</span><span class="lang-ko">뉴스</span></a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-section">
        <div class="section-eyebrow"><span class="lang-en">Research output</span><span class="lang-ko">연구 성과</span></div>
        <h2 class="section-title">
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit"
            ><span class="lang-en">Selected publications</span><span class="lang-ko">대표 논문</span></a
          >
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">
          <span class="lang-en">{{ site.contact_note }}</span>
          <span class="lang-ko">연구 협업이나 질문은 언제든 이메일로 연락 주세요.</span>
        </div>
      </div>
    {% endif %}
  </article>
</div>
