---
layout: default
---
<div class="post about-page">
  <article>
    {{ content }}

    {% assign news_items = site.news | sort: 'date' | reverse %}
    {% if news_items.size > 0 %}
      <section class="block">
        <h2 class="block-title"><span class="lang-en">News</span><span class="lang-ko">소식</span></h2>
        <ul class="news-list">
          {% for item in news_items limit: page.news_limit %}
            <li>
              <time datetime="{{ item.date | date: '%Y-%m-%d' }}"><span class="lang-en">{{ item.date | date: '%b %Y' }}</span><span class="lang-ko">{{ item.date | date: '%Y. %-m.' }}</span></time>
              <div class="news-body">{{ item.content | remove: '<p>' | remove: '</p>' }}</div>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    <section class="block contact">
      <h2 class="block-title"><span class="lang-en">Contact</span><span class="lang-ko">연락처</span></h2>
      <p class="contact-mail"><a href="mailto:jingoolee@unist.ac.kr">jingoolee@unist.ac.kr</a></p>
      <p class="contact-note">
        <span class="lang-en">UNIST, Ulsan, Korea. Email is the best way to reach me.</span>
        <span class="lang-ko">UNIST, 울산. 연구 협업이나 질문은 이메일로 연락 주세요.</span>
      </p>
    </section>
  </article>
</div>
